@page "/"

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
</head>

<body class="stone-brick-bg">
    <div class="page-container">
        <NavBar />

        <div class="hero-banner" style="background-image:url('images/big_images/herobanner.jpg')">
            <div class="hero-image-wrapper">
                <img class="hero-avatar" src="images/gifs/donut.gif" alt="Donut animation">
            </div>

            <div class="hero-content-wrapper">
                <div class="hero-card">
                    <h1 class="hero-title">Hi, my name is Sanaan</h1>
                    <div class="hero-text">
                        <p class="hero-description">
                            I am from <span class="highlight-location"><b>Islamabad,Pakistan</b></span>. I am pursuing my Bachelor's in <span class="highlight-location"><strong>Software Engineering</strong></span> from
                            <span class="highlight-location"><strong>Fast University, Islamabad.</strong></span> I am a <span class="highlight-skill"><strong>full stack and cross-platform developer</strong></span>. I am fluent in <span class="highlight-skill"><strong>C#, Js/Ts, Kotlin and Rust</strong></span>.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="police-container">
            <h1 class="section-title police-tape-animation">MORE ABOUT ME</h1>
        </div>

        <div class="card-grid">
            <FolderCard
                Heading="Personal Profile"

                Href="profile" />

            <FolderCard
                Heading="Career Goals"

                Href="career" />

            <FolderCard
                Heading="Projects"

                Href="project" />

            <FolderCard
                Heading="Skills/Interests"

                Href="skill" />

            <FolderCard
                Heading="Contact"
                Href="contact" />
        </div>
    </div>
</body>
</html>
